__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Eval output is regenerated by scripts/run_eval.py
eval/results/*.tmp
