# Copy to `.env` for local use. Keep real credentials out of source control.

# Required for OpenRouter inference. Create a key in your OpenRouter account.
OPENROUTER_API_KEY=

# Default is a vision-capable Gemma model routed through OpenRouter.
OPENROUTER_MODEL_ID=google/gemma-3-4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Inference timeouts in seconds.
SIDEQUEST_GEN_TIMEOUT=45
SIDEQUEST_VERIFY_TIMEOUT=60

# Where the front end and player data live.
SIDEQUEST_WEB_DIR=web
SIDEQUEST_DATA_DIR=data
