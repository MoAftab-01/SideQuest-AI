# SideQuest AI -- configuration
#
# Copy to `.env` for local use. `.env` is gitignored; never commit a filled-in
# copy of this file.
#
# Every one of these is OPTIONAL. With none of them set, the app runs on the
# deterministic generator with no model weights and no network -- which is the
# configuration the whole test suite and the published baseline numbers use.

# ---------------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------------
# Primary open-weight model. `google/gemma-3-*` repos are GATED on HuggingFace:
# you must accept Google's Gemma licence while logged in, then supply a token
# below, or every load returns HTTP 401 and the app falls back to deterministic
# generation (correctly, and visibly, via /api/health).
SIDEQUEST_MODEL_ID=google/gemma-3-4b-it

# Smaller model tried if the primary fails to load. Same licence gate.
SIDEQUEST_FALLBACK_MODEL_ID=google/gemma-3-1b-it

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# HuggingFace read token with access to the gated Gemma repos above.
# Generate at https://huggingface.co/settings/tokens ("Read" is enough).
# NEVER commit a real token. Leave unset to run fully without the model.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
# Load the model during application startup rather than on first request.
# Off by default: a cold multi-gigabyte download would otherwise stall a
# health check or a first request behind it.
SIDEQUEST_EAGER_LOAD=0

# Where the front end lives, relative to the process working directory.
# The container sets this to the bundled `web/`.
SIDEQUEST_WEB_DIR=web

# ---------------------------------------------------------------------------
# Hard inference timeouts (seconds)
# ---------------------------------------------------------------------------
# A model that hangs must not hang the request. On timeout the generation call
# returns None and the app falls back to the deterministic generator and says
# so, rather than holding the connection open.
SIDEQUEST_GEN_TIMEOUT=45
SIDEQUEST_VERIFY_TIMEOUT=60

# ---------------------------------------------------------------------------
# Data storage
# ---------------------------------------------------------------------------
# Player progress lives here as JSON, one file per player. Kept local by
# default; nothing is uploaded except a photo the player explicitly submits
# for model checking.
SIDEQUEST_DATA_DIR=data
